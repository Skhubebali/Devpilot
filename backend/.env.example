# Neon PostgreSQL connection
DB_URL=jdbc:postgresql://<your-neon-host>/devpilot?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_db_password

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# Token Encryptor
TOKEN_ENCRYPTOR_PASSWORD=your_token_encryptor_password
TOKEN_ENCRYPTOR_SALT=your_token_encryptor_salt

# Frontend & CORS
FRONTEND_URL=https://<your-vercel-app>.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:3000
