# Neon PostgreSQL connection
DB_URL=jdbc:postgresql://<your-neon-host>/devpilot?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_db_password

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OpenRouter API Key (free models via openrouter.ai)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# Token Encryptor
TOKEN_ENCRYPTOR_PASSWORD=your_token_encryptor_password
TOKEN_ENCRYPTOR_SALT=your_token_encryptor_salt

# Frontend & CORS
FRONTEND_URL=https://<your-vercel-app>.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:3000

# Session Cookies
# For production (Render/HTTPS): COOKIE_SAME_SITE=none, COOKIE_SECURE=true
# For local dev (HTTP): COOKIE_SAME_SITE=lax, COOKIE_SECURE=false
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
